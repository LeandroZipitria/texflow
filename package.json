{
  "name": "texflow",
  "displayName": "TeXFlow — Visual LaTeX",
  "description": "A visual editor for real LaTeX and Beamer files in VS Code, with semantic text editing, math, citations, references, figures, tables, layout tools, and source-preserving round trips.",
  "version": "0.20.0",
  "publisher": "leandrozipitria",
  "license": "MIT",
  "homepage": "https://github.com/LeandroZipitria/texflow#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/LeandroZipitria/texflow.git"
  },
  "bugs": {
    "url": "https://github.com/LeandroZipitria/texflow/issues"
  },
  "keywords": [
    "latex",
    "tex",
    "beamer",
    "visual editor",
    "academic writing",
    "mathematics",
    "citations",
    "tables"
  ],
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other",
    "Programming Languages",
    "Visualization"
  ],
  "activationEvents": [
    "onCommand:texflow.openVisualEditor",
    "onCommand:texflow.projectCheck",
    "onCommand:texflow.newProject",
    "onCommand:texflow.openDocument",
    "onView:texflow.homeView",
    "onView:texflow.projectView",
    "onCommand:texflow.refreshProjectNavigator"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "configuration": {
      "title": "TeXFlow",
      "properties": {
        "texflow.spellCheck.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable local spell checking in the TeXFlow visual editor."
        },
        "texflow.spellCheck.language": {
          "type": "string",
          "default": "auto",
          "enum": [
            "auto",
            "en",
            "es"
          ],
          "enumDescriptions": [
            "Automatic",
            "English",
            "Español"
          ],
          "description": "Preferred spell checking language."
        },
        "texflow.customEnvironments": {
          "type": "array",
          "default": [],
          "description": "Optional simple LaTeX environments that TeXFlow may edit visually. Unsupported or complex instances remain preserved as raw LaTeX.",
          "items": {
            "type": "object",
            "required": [
              "name"
            ],
            "properties": {
              "name": {
                "type": "string",
                "description": "LaTeX environment name, for example mytheorem."
              },
              "title": {
                "type": "string",
                "description": "Label shown in the visual editor."
              },
              "visualType": {
                "type": "string",
                "default": "box",
                "enum": [
                  "box",
                  "theorem",
                  "note",
                  "plain"
                ],
                "description": "Visual presentation only; the original environment name is preserved."
              }
            }
          }
        }
      }
    },
    "commands": [
      {
        "command": "texflow.openVisualEditor",
        "title": "TeXFlow: Open with TeXFlow"
      },
      {
        "command": "texflow.openDocument",
        "title": "TeXFlow: Open Document"
      },
      {
        "command": "texflow.projectCheck",
        "title": "TeXFlow: Check Project"
      },
      {
        "command": "texflow.newProject",
        "title": "TeXFlow: New Document"
      },
      {
        "command": "texflow.refreshProjectNavigator",
        "title": "TeXFlow: Refresh Project",
        "icon": "$(refresh)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "texflow",
          "title": "TeXFlow",
          "icon": "media/texflow-activity.svg"
        }
      ]
    },
    "views": {
      "texflow": [
        {
          "type": "webview",
          "id": "texflow.homeView",
          "name": "Start"
        },
        {
          "id": "texflow.projectView",
          "name": "Project"
        }
      ]
    },
    "menus": {
      "editor/title": [
        {
          "command": "texflow.openVisualEditor",
          "when": "resourceExtname == .tex",
          "group": "navigation"
        }
      ],
      "explorer/context": [
        {
          "command": "texflow.newProject",
          "when": "explorerResourceIsFolder",
          "group": "navigation@1"
        },
        {
          "command": "texflow.openVisualEditor",
          "when": "resourceExtname == .tex",
          "group": "navigation@2"
        },
        {
          "command": "texflow.projectCheck",
          "when": "resourceExtname == .tex",
          "group": "navigation@3"
        }
      ],
      "view/title": [
        {
          "command": "texflow.newProject",
          "when": "view == texflow.homeView",
          "group": "navigation@1"
        },
        {
          "command": "texflow.openDocument",
          "when": "view == texflow.homeView",
          "group": "navigation@2"
        },
        {
          "command": "texflow.refreshProjectNavigator",
          "when": "view == texflow.projectView",
          "group": "navigation@1"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "texflow.projectView",
        "contents": "Open or create a TeXFlow document to see its project files.",
        "when": "!texflow.hasProject"
      }
    ]
  },
  "scripts": {
    "compile": "tsc -p .",
    "check:runtime": "node tests/parser_single_source_runtime.js && node tests/project_active_master_runtime.js && node tests/review_runtime.js && node tests/keyboard_navigation_runtime.js && node tests/entrypoint_runtime.js && node tests/multifile_project_runtime.js && node tests/project_index_runtime.js && node tests/references_runtime.js && node tests/bibliography_index_runtime.js && node tests/diagnostics_runtime.js && node tests/active_document_edit_runtime.js && node tests/project_issues_runtime.js && node tests/project_navigation_ui_runtime.js && node tests/build_b_runtime.js && node tests/math_numbering_runtime.js && node tests/structural_numbering_runtime.js && node tests/build_c_runtime.js && node tests/build_d_behavior_runtime.js && node tests/tikz_preview_lifecycle_runtime.js && node tests/beamer_frame_operations_runtime.js && node tests/visual_source_runtime.js && node tests/spellcheck_runtime.js && node tests/beamer_parser_parity.js",
    "check:fast": "npm run compile && npm run check:runtime",
    "check": "npm run check:fast && bash tests/run_fixtures.sh",
    "check:release": "npm run check && npm run package",
    "package": "npm run compile && vsce package"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@types/vscode": "^1.90.0",
    "@vscode/vsce": "^3.9.2",
    "typescript": "^7.0.2"
  },
  "icon": "media/texflow-icon.png",
  "dependencies": {
    "@cspell/dict-en_us": "^4.4.37",
    "@cspell/dict-es-es": "^3.0.8",
    "cspell-lib": "^9.8.0"
  }
}
